# Copy this file to `.env` and fill in real values.
#   cp example.env .env
#
# Vite only exposes variables prefixed with VITE_ to the client.
# Restart `npm run dev` after changing any of these.

# Public site origin used for canonical URLs, Open Graph, and JSON-LD.
# No trailing slash.
VITE_SITE_URL=https://olla.media

# Optional. When set, contact and newsletter forms POST to this API.
# Leave empty to keep forms UI-only.
VITE_API_BASE_URL=

# Optional. Google Search Console HTML-tag verification token.
VITE_GOOGLE_SITE_VERIFICATION=
